<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ControlCANFD.dll 为 x64，进程必须固定为 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets\yclab.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\yclab.ico" LogicalName="waist_motor_controller.yclab.ico" />
    <None Update="native\ControlCANFD.dll">
      <!-- P/Invoke 与启动检查都在输出根目录找 DLL，故 Link 到根 -->
      <Link>ControlCANFD.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
