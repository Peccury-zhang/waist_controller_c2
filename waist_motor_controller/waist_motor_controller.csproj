<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ControlCANFD.dll 为 x64，进程必须固定为 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>assets\yclab.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The designer can generate a duplicate resource for the MainForm partial class. -->
    <EmbeddedResource Remove="UI\MainForm.Layout.resx" />
    <EmbeddedResource Include="assets\yclab.ico" LogicalName="waist_motor_controller.yclab.ico" />
    <EmbeddedResource Include="assets\yclab2_orange.png" LogicalName="waist_motor_controller.yclab2_orange.png" />
    <None Update="native\ControlCANFD.dll">
      <!-- P/Invoke 与启动检查都在输出根目录找 DLL，故 Link 到根 -->
      <Link>ControlCANFD.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WaistModel/WaistModel.csproj" />
    <ProjectReference Include="../RobotVisualization/RobotVisualization.csproj" />
    <Content Include="../../shared_files/urdf_G3_06/**/*" Link="assets/robot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
